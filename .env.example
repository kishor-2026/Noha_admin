# Catalyst connection for the admin server.
# Copy to .env.local and fill in. See docs/CATALYST-SETUP.md.
# With these absent the server runs on in-memory sample data.

CATALYST_PROJECT_ID=
CATALYST_ORG_ID=
CATALYST_CLIENT_ID=
CATALYST_CLIENT_SECRET=
CATALYST_REFRESH_TOKEN=

# Which schema the project uses:
#   noah  the Catalyst developer's normalised schema (noah-backend)
#   flat  the four flat tables this console creates itself
CATALYST_SCHEMA=noah

# Only needed when CATALYST_SCHEMA=flat. The noah schema has its ids built in.
CATALYST_TABLE_STAFF=
CATALYST_TABLE_REGISTRATIONS=
CATALYST_TABLE_MEMBERS=
CATALYST_TABLE_AUDITLOG=

# Who may sign in to the console, and as what. See docs/CONSOLE-ACCESS.md.
#
# The id of the table the Catalyst developer sets up to hold console roles.
# Without it, only the office's super administrators (users.is_super_admin)
# and test accounts can sign in, and "Give access to a member" says what is
# missing.
CATALYST_TABLE_CONSOLE_STAFF=

# Test accounts: +91 90000 00001 (super administrator) to ...10, one per role.
# On locally by default, with the one-time code 123456. In production they are
# OFF unless both of these are set, and there is deliberately no default code:
#   ENABLE_TEST_LOGIN=true
#   TEST_LOGIN_OTP=<a code you choose>
# ENABLE_TEST_LOGIN=false turns them off anywhere. Switch them off before real use.
ENABLE_TEST_LOGIN=
TEST_LOGIN_OTP=
