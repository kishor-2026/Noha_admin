# Catalyst connection for the admin server.
# Copy to .env.local and fill in. See docs/CATALYST-SETUP.md.
# With these absent the server runs on in-memory sample data.

CATALYST_PROJECT_ID=73626000000028001
CATALYST_ORG_ID=60088815946
CATALYST_ENV=Development
CATALYST_CLIENT_ID=
CATALYST_CLIENT_SECRET=
CATALYST_REFRESH_TOKEN=

# Which schema the project uses:
#   noah  the Catalyst developer's normalised schema (noah-backend)
#   flat  the four flat tables this console creates itself
CATALYST_SCHEMA=noah

# Only needed when CATALYST_SCHEMA=flat. The noah schema has its ids built in.
CATALYST_TABLE_STAFF=
CATALYST_TABLE_REGISTRATIONS=
CATALYST_TABLE_MEMBERS=
CATALYST_TABLE_AUDITLOG=

# Who may sign in to the console, and as what. See docs/CONSOLE-ACCESS.md.
#
# Console roles are kept in six columns on membersExtra (npm run catalyst:columns
# -- --apply adds them). Only if a project has room for a table of its own, put its
# id here instead. Leave empty otherwise.
CATALYST_TABLE_CONSOLE_STAFF=

# Test accounts: +91 90000 00001 (super administrator) to ...10, one per role.
# On locally by default, with the one-time code 123456. In production they are
# OFF unless both of these are set, and there is deliberately no default code:
#   ENABLE_TEST_LOGIN=true
#   TEST_LOGIN_OTP=<a code you choose>
# ENABLE_TEST_LOGIN=false turns them off anywhere. Switch them off before real use.
ENABLE_TEST_LOGIN=
TEST_LOGIN_OTP=

# How the one-time sign-in code reaches people. A staff member signs in with
# their mobile number (the code is texted) or their email address (the code is
# emailed). Each is off until it is filled in; a channel that is off falls back to
# showing the code on screen locally, and refuses on a deployed server unless
# ADMIN_PASSPHRASE is set. See docs/CONSOLE-ACCESS.md.
#
# Email: any SMTP account (Zoho Mail, Gmail app password, SendGrid, Brevo...).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Karuna Sadan <no-reply@yourdomain.org>
#
# SMS: Twilio. Indian numbers need the sender and message template registered
# (DLT) before messages are delivered; Twilio explains how.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# One of these two: a number you own, or a Messaging Service id.
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
