{
  "name": "karuna-sadan-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Karuna Sadan admin console — React front end for the Noah and Jodie mobile apps",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:web:offline": "vite --mode offline --port 5180 --strictPort",
    "dev:api": "node server/index.js",
    "build": "tsc --noEmit && node server/field-audit.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "audit:fields": "node server/field-audit.mjs",
    "test:contract": "node server/contract-test.mjs",
    "test:journey": "node server/test-full-journey.mjs",
    "test:roles": "node server/test-roles.mjs",
    "export:catalyst": "node server/export-catalyst.mjs",
    "test:noah": "node server/test-noah-api.mjs",
    "probe:filestore": "node server/probe-filestore.mjs",
    "catalyst:scopes": "node server/catalyst.js --scopes",
    "start": "node server/index.js",
    "check:schema": "node server/check-schema.mjs",
    "catalyst:columns": "node server/ensure-columns.mjs",
    "catalyst:connect": "node server/connect.mjs",
    "deploy:slate": "node server/deploy-slate.mjs",
    "test:connect": "node server/test-connect.mjs",
    "test:schema": "node server/test-schema-offline.mjs",
    "dev:offline": "node server/dev-offline.mjs",
    "test:stack": "node server/test-offline-stack.mjs"
  },
  "dependencies": {
    "cors": "2.8.5",
    "express": "4.21.1",
    "nodemailer": "6.9.16",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.2"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "concurrently": "9.0.1",
    "typescript": "5.6.3",
    "vite": "5.4.10"
  },
  "engines": {
    "node": ">=20"
  }
}
