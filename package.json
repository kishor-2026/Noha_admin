{
  "name": "karuna-sadan-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Karuna Sadan admin console — React front end for the Noah and Jodie mobile apps",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node server/index.js",
    "build": "tsc --noEmit && node server/field-audit.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "audit:fields": "node server/field-audit.mjs",
    "test:contract": "node server/contract-test.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.2"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "concurrently": "9.0.1",
    "cors": "2.8.5",
    "express": "4.21.1",
    "typescript": "5.6.3",
    "vite": "5.4.10"
  }
}
